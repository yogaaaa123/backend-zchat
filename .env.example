# Server
APP_PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=social_forum
DB_SSLMODE=disable

# JWT
JWT_SECRET=ubah-ini-dengan-secret-yang-kuat
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=168h

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
